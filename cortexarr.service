# Template — install.sh substitutes __INSTALL_DIR__ / __LOG_DIR__ /
# __SERVICE_USER__ / __SERVICE_GROUP__ before installing to systemd.
# For a manual install, replace these placeholders yourself.
#
# Host/port are NOT set here — app/config.py reads them from config.yaml at
# each process start, so a port change only needs config.yaml rewritten +
# a restart, not a unit file edit.
[Unit]
Description=Cortexarr — media acquisition pipeline health monitoring
Documentation=https://github.com/bsnwgit/cortexarr
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__INSTALL_DIR__

Environment=CORTEXARR_CONFIG=__INSTALL_DIR__/config.yaml
Environment=CORTEXARR_INSTALL_DIR=__INSTALL_DIR__

ExecStart=__INSTALL_DIR__/venv/bin/python -m app.main

# always, not on-failure: self-update (app/self_update.py) applies a new
# release by swapping files in place and then exiting cleanly, relying on
# systemd to bring the new code back up. An explicit `systemctl stop` or
# `restart` still wins over this — systemd doesn't restart a unit that was
# asked to stop, regardless of Restart=.
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

StandardOutput=append:__LOG_DIR__/cortexarr.log
StandardError=append:__LOG_DIR__/cortexarr.log

NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
